{
  "expo": {
    "name": "Zencademy - Train Your Mind",
    "slug": "zencademy-app",
    "version": "0.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zencademyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "zencademy.appzen",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Zencademy alerts you when a focus or meditation session ends."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "zencademy.appzen",
      "versionCode": 10,
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "dark"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#B91C1C",
          "defaultChannel": "sessions"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b097bcc-035e-4b81-a490-9a7788336c2b"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content",
      "hidden": true
    },
    "owner": "zencademy1"
  }
}
